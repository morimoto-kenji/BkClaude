      <ModuleDefinitionFile>src\BkClaude.def</ModuleDefinitionFile>
      <AdditionalDependencies>winhttp.lib;crypt32.lib;comctl32.lib;shell32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <ResourceCompile>
      <!-- The resource compiler has its own preprocessor; without this the
           VERSIONINFO block cannot tell a Debug build from Release. -->
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <ClCompile>
